<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.iss.controler.LoginView">
   <children>
      <PasswordField fx:id="passwordText" layoutX="234.0" layoutY="215.0" />
      <TextField fx:id="usernameText" layoutX="234.0" layoutY="175.0" />
      <Button fx:id="loginButton" layoutX="176.0" layoutY="304.0" mnemonicParsing="false" onAction="#handleLogin" text="Login" />
      <Button fx:id="registerButton" layoutX="373.0" layoutY="304.0" mnemonicParsing="false" text="Register" />
      <Label layoutX="253.0" layoutY="78.0" text="Spital">
         <font>
            <Font size="38.0" />
         </font>
      </Label>
      <Label fx:id="errorLabel" layoutX="418.0" layoutY="361.0" prefHeight="18.0" prefWidth="162.0" />
   </children>
</AnchorPane>
