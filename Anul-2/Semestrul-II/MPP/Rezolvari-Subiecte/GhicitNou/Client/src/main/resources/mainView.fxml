<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="435.0" prefWidth="706.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.client.MainView">
    <children>
        <GridPane fx:id="gridPane" layoutX="28.0" layoutY="82.0" prefHeight="106.0" prefWidth="359.0" style="-fx-background-color: grey;">
        </GridPane>
        <TableView fx:id="tabelClasament" layoutX="408.0" layoutY="82.0" prefHeight="256.0" prefWidth="259.0">
            <columns>
                <TableColumn fx:id="colUsername" prefWidth="75.0" text="Username" />
                <TableColumn fx:id="colPuncte" prefWidth="75.0" text="Puncte" />
                <TableColumn fx:id="colDurata" prefWidth="75.0" text="Durata" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Label fx:id="warningText" layoutX="116.0" layoutY="14.0" text="Memory Game">
            <font>
                <Font size="17.0" />
            </font>
        </Label>
        <Label layoutX="494.0" layoutY="32.0" text="Clasament">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Button fx:id="startButton" layoutX="172.0" layoutY="228.0" mnemonicParsing="false" onAction="#handleStart" text="Play" />
        <Label fx:id="lblStatus" layoutX="164.0" layoutY="370.0" prefHeight="26.0" prefWidth="279.0" text="Status">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
