<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="435.0" prefWidth="706.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.client.MainView">
    <children>
        <TableView fx:id="tabelClasament" layoutX="408.0" layoutY="82.0" prefHeight="256.0" prefWidth="259.0">
            <columns>
                <TableColumn fx:id="colUsername" prefWidth="75.0" text="Username" />
                <TableColumn fx:id="colPuncte" prefWidth="75.0" text="Puncte" />
                <TableColumn fx:id="colDurata" prefWidth="75.0" text="Durata" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Label fx:id="warningText" layoutX="113.0" layoutY="88.0">
            <font>
                <Font size="17.0" />
            </font>
        </Label>
        <Label layoutX="494.0" layoutY="32.0" text="Clasament">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Button fx:id="startButton" layoutX="28.0" layoutY="366.0" mnemonicParsing="false" onAction="#handleStart" text="Play" />
        <Label fx:id="lblStatus" layoutX="164.0" layoutY="370.0" prefHeight="26.0" prefWidth="279.0" text="Status">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
      <TextArea fx:id="guessBox" layoutX="52.0" layoutY="129.0" prefHeight="57.0" prefWidth="250.0" />
      <Button fx:id="guessButton" layoutX="151.0" layoutY="205.0" mnemonicParsing="false" onAction="#handleGuess" text="Guess" />
    </children>
</AnchorPane>
